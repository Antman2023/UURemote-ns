function(add_switch_curl)
    # Verify HTTPS in-process so emulator SSL services cannot weaken certificate checks.
    set(CURL_USE_MBEDTLS ON)
    set(CURL_USE_OPENSSL OFF)
    set(MBEDTLS_INCLUDE_DIR "${CMAKE_SOURCE_DIR}/external/mbedtls/include")
    set(MBEDTLS_LIBRARY mbedtls)
    set(MBEDX509_LIBRARY mbedx509)
    set(MBEDCRYPTO_LIBRARY mbedcrypto)
    set(CURL_USE_PKGCONFIG OFF)
    set(CURL_USE_LIBPSL OFF)
    set(CURL_USE_LIBSSH2 OFF)
    set(BUILD_CURL_EXE OFF)
    set(BUILD_TESTING OFF)
    set(CURL_DISABLE_INSTALL ON)
    set(CURL_DISABLE_MIME ON)
    set(CURL_DISABLE_SOCKETPAIR ON)
    set(ENABLE_IPV6 OFF)
    set(ENABLE_THREADED_RESOLVER OFF)
    set(USE_NGHTTP2 OFF)
    foreach(protocol DICT FILE FTP GOPHER IMAP LDAP LDAPS MQTT POP3 RTSP SMB SMTP TELNET TFTP WEBSOCKETS)
        set(CURL_DISABLE_${protocol} ON)
    endforeach()
    list(APPEND CMAKE_REQUIRED_LIBRARIES nx)
    add_subdirectory(external/curl EXCLUDE_FROM_ALL)
endfunction()

add_switch_curl()
